FROM node:18-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache python3 make g++ postgresql-client

# Copy package files
COPY package.json ./

# Install dependencies
RUN npm install

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=development

# Start the application in development mode
CMD ["npm", "run", "start:dev"]