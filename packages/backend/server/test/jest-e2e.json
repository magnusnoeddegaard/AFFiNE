{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/../src/$1",
    "^@base/(.*)$": "<rootDir>/../src/base/$1",
    "^@core/(.*)$": "<rootDir>/../src/core/$1",
    "^@plugins/(.*)$": "<rootDir>/../src/plugins/$1",
    "^@models/(.*)$": "<rootDir>/../src/models/$1"
  }
}